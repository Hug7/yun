set(PACKAGE_VERSION "@YUN_VERSION@")

set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION_MAJOR EQUAL 0)
        string(REGEX REPLACE "^[0-9]+\\.([0-9]+).*" "\\1" _yun_minor "${PACKAGE_VERSION}")
        if(NOT PACKAGE_FIND_VERSION_MINOR EQUAL _yun_minor)
            set(PACKAGE_VERSION_COMPATIBLE FALSE)
        endif()
    endif()
    if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
